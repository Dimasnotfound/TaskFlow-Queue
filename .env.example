# Application
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskflow_queue

# Redis connection used by BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT access token secret. Use at least 32 chars in real deployment.
JWT_ACCESS_SECRET=change-this-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m

# Queue and worker configuration
DEFAULT_QUEUE_NAME=default
WORKER_NAME=default-worker-1
WORKER_CONCURRENCY=5

# Local output folder for generated demo files
STORAGE_PATH=./src/storage
